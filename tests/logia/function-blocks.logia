function block_count() i64 {
    var i64 i = 0;

    {
        i = i + 1
    }

    {
        if true {
            i = i + 10
        }
    }

    {
        if false {
            i = i + 999
        } else {
          i = i + 100
        }
    }

    if false {
        i = i + 999;
    } else {
        i = i + 1000
    }


    if false {
        i = i + 999;
    } else if false {
        i = i + 999;
    } else {
        i = i + 10000
    }

    return i
}

function main() i64 {
    var count = block_count()
    return count
}
