type point = struct {
    float x
    float y
    operator + (point other) point {
        var point ret = {0,0}
        ret.x = this.x + other.x
        ret.y = this.y + other.y

        return ret
    }
}


function main () i64 {
    var point p1 = {10,11}
    var point p2 = {21,22}

    p3 = p1 + p2

    return p3.x + p3.y
}