function a() i32 {
    if (true or false) {
        return 1
    }
    return 0
}

function b() i32 {
    if (false or true) {
        return 1
    }
    return 0
}

function c() i32 {
    if (true or true) {
        return 1
    }
    return 0
}

function d() i32 {
    if (false or false) {
        return 1
    }
    return 0
}


function main() i32 {
    //return a() + b() + c() + d()
    var i32 a1 = a() + b()
    var i32 a2 = c() + d()
    return a1 + a2
}